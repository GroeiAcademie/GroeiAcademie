echo.
echo Totaal !TESTS! - OK !OK! - FOUT !FAIL!
popd
echo === TEST VOLLEDIG AFGEROND ===
if /I not "%~2"=="--no-pause" (
    <nul set /p =[EINDE] Testen voltooid. Druk op een toets om af te sluiten... & pause >nul
    echo.
)
if !FAIL!==0 (exit /b 0) else exit /b 1
