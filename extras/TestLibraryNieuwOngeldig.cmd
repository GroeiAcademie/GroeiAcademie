set "TEST_NAAM=HX1838_BRON_CODES_DEFINE | OK ONDERAAN 17 | HX1838_CODE_17 = 0"
set "TEST_FLAGS=-DINPUT_KANAAL_CONFIG=INPUT_TYPE_HX1838 -DHX1838_BRON_CODES=HX1838_BRON_CODES_DEFINE -DHX1838_TOETSENINDELING=HX1838_TOETSENINDELING_REMOTE_OK_ONDERAAN_17_TOETSEN -DHX1838_CODE_17=0"
