set "VERWACHTE_FOUT=HX1838_USE_TINYIRRECEIVER_INSTEAD_OF_IRREMOTE moet 0 of 1 zijn."
call :EXPECT_FAIL

set "TEST_NAAM=HX1838_BRON_CODES_DEFINE | OK BOVENAAN 17 | HX1838_CODE_17 = 0"
set "TEST_FLAGS=-DINPUT_KANAAL_CONFIG=INPUT_TYPE_HX1838 -DHX1838_BRON_CODES=HX1838_BRON_CODES_DEFINE -DHX1838_TOETSENINDELING=HX1838_TOETSENINDELING_REMOTE_OK_BOVENAAN_17_TOETSEN -DHX1838_CODE_17=0"
