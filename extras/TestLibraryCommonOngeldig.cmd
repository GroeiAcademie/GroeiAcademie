@echo off
if /I "%~1"=="--VOER_DEZE_ONGELDIGE_TEST_UIT" goto :VOER_DEZE_ONGELDIGE_TEST_UIT

setlocal enabledelayedexpansion
set "LOG_BESTAND=%~dp0!BESTANDSNAAM!.txt"
set "TEST_SCRIPT_BESTAND=%~dp0!BESTANDSNAAM!.cmd"

if /I "%~1"=="--logged" goto :MAIN_SCRIPT

if exist "!LOG_BESTAND!" del /q "!LOG_BESTAND!" >nul 2>&1
powershell -NoProfile -Command "& { & $env:ComSpec /D /C '""!TEST_SCRIPT_BESTAND!" --logged %* 2>&1"' | Tee-Object -FilePath '!LOG_BESTAND!'; exit $LASTEXITCODE }"
set "SCRIPT_RESULT=!errorlevel!"
exit /b !SCRIPT_RESULT!

:MAIN_SCRIPT
pushd "%~dp0.."

:: Bepaal welk pad bestaat
:: Zoek arduino-cli via PATH; anders via extras\LokalePaden.cmd (lokaal, niet gedeeld - zie extras\LokalePaden_template.cmd om aan te maken).
:: Geen paden van specifieke personen/machines in dit gedeelde script.
where arduino-cli >nul 2>&1
if exist "extras\LokalePaden.cmd" (
    call "extras\LokalePaden.cmd"
) else (
    where arduino-cli >nul 2>&1
    if not errorlevel 1 (
        for /f "delims=" %%P in ('where arduino-cli') do set "CLI_PATH=%%~dpnP"
    ) else (
        echo arduino-cli niet gevonden via PATH, en extras\LokalePaden.cmd bestaat niet.
        exit /b 1
    )
)

set "CONTROLE_BESTAND=%~dp0!BESTANDSNAAM!.ino"

    set "GA_ONGELDIG_BRON=!BRON_TEST_SCRIPT!"
    set "GA_ONGELDIG_CONTROLE=!CONTROLE_BESTAND!"
    set "GA_ONGELDIG_MODUS=!CONTROLE_MODUS!"
    set "GA_ONGELDIG_PADEN=!CONTROLE_PADEN!"
    set "GA_ONGELDIG_ROOT=!CD!"
    set "GA_ONGELDIG_EXTRAS=%~dp0"
    powershell -NoProfile -EncodedCommand 
    if errorlevel 1 (
        echo FOUT: controlelijst Ongeldig kon niet worden opgebouwd.
        popd
        exit /b 1
    )

set "CONTROLE_SIZE=0"
for %%A in ("!CONTROLE_BESTAND!") do set "CONTROLE_SIZE=%%~zA"
if !CONTROLE_SIZE! GTR 0 (
    echo.
    echo [CONTROLE ONGELDIG] Controleer: !CONTROLE_BESTAND!
    popd
    exit /b 1
)

call "!TEST_SCRIPT_BESTAND!" --TESTLIJST
set "SCRIPT_RESULT=!errorlevel!"

popd
echo === TEST VOLLEDIG AFGEROND ===
if /I not "%~2"=="--no-pause" (
    <nul set /p =[EINDE] Testen voltooid. Druk op een toets om af te sluiten... & pause >nul
    echo.
)
exit /b !SCRIPT_RESULT!

:VOER_DEZE_ONGELDIGE_TEST_UIT
set /A TESTS+=1
set "TEST_INO_ACTIEF=!TEST_INO:"=!"
for %%I in ("!TEST_INO_ACTIEF!") do set "TEST_DIR=%%~dpI"
set "TEST_DIR=!TEST_DIR:~0,-1!"
set "EXTRA_FLAGS=!TEST_FLAGS!"
if defined TEST_BOARD_VERSION set "EXTRA_FLAGS=!EXTRA_FLAGS! -DBOARD_VERSION=!TEST_BOARD_VERSION!"

"%CLI_PATH%" compile --jobs 1 --fqbn "!TEST_FQBN!" --build-property "compiler.cpp.extra_flags=-DGROEIACADEMIE_IGNORE_USER_CONFIG !EXTRA_FLAGS!" "!TEST_DIR!" >"%TEMP%\GA_Ongeldig.txt" 2>&1
set "COMPILE_RESULT=!errorlevel!"

if "!COMPILE_RESULT!"=="0" (
    echo [FOUT] !TEST_NAAM! compileerde onverwacht.
    set /A FAIL+=1
) else (
    >"%TEMP%\GA_VerwachteFout.txt" echo(!VERWACHTE_FOUT!
    powershell -NoProfile -Command "$log=[IO.File]::ReadAllText('%TEMP%\GA_Ongeldig.txt'); $verwacht=[IO.File]::ReadAllText('%TEMP%\GA_VerwachteFout.txt').TrimEnd([char]13,[char]10); if ($log.Contains($verwacht)) { exit 0 } else { exit 1 }"
    if errorlevel 1 (
        echo [FOUT] !TEST_NAAM! faalde om een andere reden dan verwacht.
        type "%TEMP%\GA_Ongeldig.txt"
        set /A FAIL+=1
    ) else (
        echo [OK] !TEST_NAAM! correct geweigerd: !VERWACHTE_FOUT!
        set /A OK+=1
    )
)

del "%TEMP%\GA_Ongeldig.txt" "%TEMP%\GA_VerwachteFout.txt" >nul 2>&1
exit /b 0

